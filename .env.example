# PostgreSQL (local install). Either set DATABASE_URL, or the DB_* parts below.
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newtonite
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/newtonite

# Signs the session cookie. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string
